static func points() -> PackedVector3Array:
	var coast := Coast.points()
	if coast.is_empty() or not coast[-1].is_equal_approx(TRACK[0]):
		return PackedVector3Array()
	var length := 0.0
	for i in range(1, TRACK.size()):
		var point: Vector3 = TRACK[i]
		var origin: Vector3 = TRACK[i - 1]
		var rise: float = absf(point.y - origin.y)
		var run := Vector2(point.x, point.z).distance_to(Vector2(origin.x, origin.z))
		if not point.is_finite() or point.y < 6.6 or not BOUNDS.has_point(Vector2(point.x, point.z)) \
				or run <= 0.01 or run > 1.6 or rise / run > 0.29:
			return PackedVector3Array()
		length += origin.distance_to(point)
	return PackedVector3Array(TRACK) if absf(length - LENGTH_METRES) < 0.005 else PackedVector3Array()


static func curve() -> Curve3D:
	var track := points()
	if track.is_empty():
		return null
	var result := Curve3D.new()
	result.bake_interval = 1.0
	for point in track:
		result.add_point(point)
	return result

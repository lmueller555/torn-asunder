[node name="Sun" parent="." index="1"]
directional_shadow_max_distance = 450.0

[node name="ObjectiveHUD" type="CanvasLayer" parent="."]
layer = 2

[node name="Panel" type="PanelContainer" parent="ObjectiveHUD"]
anchor_top = 1.0
anchor_bottom = 1.0
offset_left = 20.0
offset_top = -188.0
offset_right = 690.0
offset_bottom = -20.0
mouse_filter = 2

[node name="Margin" type="MarginContainer" parent="ObjectiveHUD/Panel"]
mouse_filter = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_right = 14
theme_override_constants/margin_top = 10
theme_override_constants/margin_bottom = 10

[node name="Readout" type="VBoxContainer" parent="ObjectiveHUD/Panel/Margin"]
mouse_filter = 2

[node name="Title" type="Label" parent="ObjectiveHUD/Panel/Margin/Readout"]

[node name="SerethCutPlaytest" instance=ExtResource("1_harness")]
script = ExtResource("3_playtest")
battlefield_scene = ExtResource("2_cut")
field_bounds = Rect2(-195, -103, 390, 200)
enable_sector_camera = true
local_sector_size = 78.0
enable_command_minimap = true
hero_spawn = NodePath("Markers/Spawns/Sereth")
formation_spawns = Array[NodePath]([NodePath("Markers/Spawns/HouseholdGuard"), NodePath("Markers/Spawns/StairGuard")])

[node name="ObjectiveHUD" type="CanvasLayer" parent="."]

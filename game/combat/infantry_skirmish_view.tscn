[sub_resource type="Shader" id="Shader_field"]
code = "shader_type spatial;
uniform vec3 ground : source_color = vec3(0.20, 0.25, 0.24);
varying vec2 ground_pos;

void vertex() {
	ground_pos = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xz;
}

void fragment() {
	vec2 cell = abs(fract(ground_pos / 2.0 + 0.5) - 0.5);
	float grid = 1.0 - smoothstep(0.006, 0.018, min(cell.x, cell.y));
	float grain = sin(dot(ground_pos, vec2(18.1, 11.5))) * sin(dot(ground_pos, vec2(8.6, -14.3)));
	float border = max(abs(ground_pos.x) - 9.0, abs(ground_pos.y) - 10.0);
	ALBEDO = ground * (0.94 + grain * 0.025 + grid * 0.12) * (1.0 - 0.36 * smoothstep(0.0, 0.55, border));
	ROUGHNESS = 0.94;
}"

